# Copy to .env for local dev. On Vercel, set these in Dashboard > Settings > Environment Variables.
# Postgres (Vercel Postgres / Neon). If empty, app falls back to built-in static catalog + mock orders.
POSTGRES_URL="postgresql://user:password@localhost:5432/dewe?schema=public"
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/dewe?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/dewe?schema=public"

# Order confirmation email (Resend). If empty, orders succeed but no mail is sent (logged to console).
# Get a free key at https://resend.com/api-keys — verify a domain or use onboarding@resend.dev for testing.
RESEND_API_KEY=""
ORDER_FROM_EMAIL="DEWE Beauty <onboarding@resend.dev>"
# Optional: BCC all order confirmations to yourself
ADMIN_EMAIL=""

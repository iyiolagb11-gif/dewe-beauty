# Copy to .env for local dev. On Vercel, set these in Dashboard > Settings > Environment Variables.
# Postgres (Vercel Postgres / Neon). If empty, app falls back to built-in static catalog + mock orders.
POSTGRES_URL="postgresql://user:password@localhost:5432/dewe?schema=public"
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/dewe?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/dewe?schema=public"

# Order confirmation email — pick ONE provider (Resend preferred once you own a domain).
# A) Resend (needs a verified domain you own to mail customers; onboarding@resend.dev only mails yourself)
RESEND_API_KEY=""
ORDER_FROM_EMAIL="DEWE Beauty <onboarding@resend.dev>"
# B) SMTP fallback (works TODAY with no custom domain, e.g. Gmail App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="DEWE Beauty <you@gmail.com>"
# Optional: BCC all order confirmations to yourself
ADMIN_EMAIL=""

# Admin dashboard login (email above + password below). Keep secret — never commit .env.
ADMIN_PASSWORD="change-me-to-a-long-random-password"
# Optional: separate secret for signing admin sessions (defaults to ADMIN_PASSWORD)
# SESSION_SECRET=""
